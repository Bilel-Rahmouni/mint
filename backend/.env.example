NODE_ENV=development
PORT=4600

# Local: mongodb://localhost:27017/mint — or a MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/mint

# Long random string, e.g. openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRE=7d

# Comma-separated origins allowed to call the API (not needed in dev, Vite proxies /api)
CORS_ORIGINS=https://mintstudio.io

# Google Play, Search Console and Analytics — path to the service account JSON key (kept out of git).
# Alternatively set GOOGLE_CLIENT_EMAIL and GOOGLE_PRIVATE_KEY (one line, literal \n, double quotes).
GOOGLE_KEY_FILE=google-service-account.json
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Play Console → Download reports → Statistics → Copy Cloud Storage URI (bucket name only)
PLAY_REPORTS_BUCKET=

# AdMob and AdSense only accept a signed-in Google account, not the service account.
# Google Cloud → Google Auth Platform → Clients → "mint backend" (Web application).
# The redirect URI must be listed on that client; in production use the public API origin.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4600/api/integrations/google/callback

# Alert email. All four are required; without them alerts stay in the sidebar bell.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=

# Publora API key. Scheduled posts publish when this is set. Blog posts are stored only.
PUBLORA_API_KEY=

# Google Ads. Needs the Ads scope, so reconnect Google once after adding it.
# Customer id is digits only (dashes are ignored). Login customer id is the manager account, if any.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Career ops board (commands + KPIs). Defaults to the career-ops-main folder next to this repo.
CAREER_OPS_DIR=

# Cursor API key so Career buttons can start hunt / renklar on this machine.
# Dashboard → Integrations. https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
